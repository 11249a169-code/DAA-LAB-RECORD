AIM:
To implement fractional knapsack using greedy method.

ALGORITHM:
Calculate profit/weight ratio
Sort items descending
Take full item if possible
Otherwise take fraction
Compute profit

PROGRAM:
#include<stdio.h>
int main()
{
    int i,j,n;
    float w[20],p[20],ratio[20],temp;
    float capacity,profit=0;
    printf("Enter number of items: ");
    scanf("%d",&n);
    printf("Enter weights and profits:\n");
    for(i=0;i<n;i++)
        scanf("%f%f",&w[i],&p[i]);
    printf("Enter capacity: ");
    scanf("%f",&capacity);
    for(i=0;i<n;i++)
        ratio[i]=p[i]/w[i];
    for(i=0;i<n;i++)
    {
        for(j=i+1;j<n;j++)
        {
            if(ratio[i]<ratio[j])
            {
                temp=ratio[i]; ratio[i]=ratio[j]; ratio[j]=temp;
                temp=w[i]; w[i]=w[j]; w[j]=temp;
                temp=p[i]; p[i]=p[j]; p[j]=temp;
            }
        }
    }
    for(i=0;i<n;i++)
    {
        if(capacity>=w[i])
        {
            profit+=p[i];
            capacity-=w[i];
        }
        else
        {
            profit+=ratio[i]*capacity;
            break;
        }
    }
    printf("Maximum profit = %f",profit);
}

OUTPUT:
Maximum profit = 240.000000

RESULT:
Thus fractional knapsack using greedy method is implemented.
