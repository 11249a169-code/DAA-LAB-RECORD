AIM:
To find maximum flow in a network using Ford-Fulkerson method.

ALGORITHM:
Read number of vertices and capacity matrix
Initialize max_flow = 0
Find augmenting path using BFS/DFS
Find minimum residual capacity in path
Update residual graph
Add path flow to max_flow
Repeat until no augmenting path
Print max_flow

PROGRAM:
#include<stdio.h>
int min(int a,int b)
{
    return (a<b)?a:b;
}
int main()
{
    int n,i,j,source,sink;
    int capacity[10][10],flow[10][10]={0};
    int visited[10],parent[10];
    int max_flow=0,path_flow;
    printf("Enter number of vertices: ");
    scanf("%d",&n);
    printf("Enter capacity matrix:\n");
    for(i=0;i<n;i++)
        for(j=0;j<n;j++)
            scanf("%d",&capacity[i][j]);
    printf("Enter source and sink: ");
    scanf("%d%d",&source,&sink);
    while(1)
    {
        for(i=0;i<n;i++)
            visited[i]=0;
        int queue[10],front=0,rear=0;
        queue[rear++]=source;
        visited[source]=1;
        parent[source]=-1;
        while(front<rear)
        {
            int u=queue[front++];
            for(i=0;i<n;i++)
            {
                if(!visited[i] && capacity[u][i]-flow[u][i]>0)
                {
                    queue[rear++]=i;
                    parent[i]=u;
                    visited[i]=1;
                }
            }
        }
        if(!visited[sink])
            break;
        path_flow=999;
        for(i=sink;i!=source;i=parent[i])
        {
            int u=parent[i];
            path_flow=min(path_flow,capacity[u][i]-flow[u][i]);
        }
        for(i=sink;i!=source;i=parent[i])
        {
            int u=parent[i];
            flow[u][i]+=path_flow;
            flow[i][u]-=path_flow;
        }

        max_flow+=path_flow;
    }
    printf("Maximum flow = %d",max_flow);
}


